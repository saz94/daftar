<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- deep indigo card -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:endColor="#120A2B" android:startColor="#251450" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- warm glow from the top corner, as on the app's screens -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.1"
                android:centerY="0.0"
                android:endColor="#00F4507A"
                android:gradientRadius="260dp"
                android:startColor="#66F4507A"
                android:type="radial" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
